# ReplyGenius Environment Variables Template
# Copy this file to .env to configure options

# Server Port (default: 3000)
PORT=3000

# Optional: Google Gemini API Key
# If omitted or empty, ReplyGenius will automatically run in
# zero-cost smart simulation mode so you can test everything for free!
# Get a free Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=
